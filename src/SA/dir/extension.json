{
    "name": "dir",
    "version": "0.0.0",
    "command_name": "sa-dir",
    "extension_author": "c2biz",
    "original_author": "TrustedSec",
    "repo_url": "https://github.com/sliverarmory/CS-Situational-Awareness-BOF",
    "help": "Lists files and directories in a target path, with optional recursive listing.",
    "long_help": "Lists directory contents including file sizes and modification times. Supports local paths, drive letters (C:), and UNC paths (\\\\server\\share). Output shows date/time, size (or <dir>/<junction>), and filename. Displays total file size and counts at the end.",
    "depends_on": "coff-loader",
    "entrypoint": "go",
    "files": [
        {
            "os": "windows",
            "arch": "amd64",
            "path": "dir.x64.o"
        },
        {
            "os": "windows",
            "arch": "386",
            "path": "dir.x86.o"
        }
    ],
    "arguments": [
        {
            "name": "targetdir",
            "desc": "Directory to list",
            "type": "string",
            "optional": true
        },
        {
            "name": "subdirs",
            "desc": "Recurse into subdirectories (0=no, 1=yes). Defaults to 0.",
            "type": "short",
            "optional": true
        }
    ]
}